# Copy to .env.local for local development (docker-compose defaults shown).

# Postgres
DATABASE_URL="postgresql://htelcrm:htelcrm@localhost:5432/htelcrm?schema=public"

# Redis (job queue)
REDIS_URL="redis://localhost:6379"

# Auth.js
AUTH_SECRET="replace-with-a-random-32-byte-value"
AUTH_URL="http://localhost:3000"

# Symmetric key used to encrypt sensitive fields at rest (e.g. MFA secrets).
# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY="replace-with-a-random-32-byte-value"

# Object storage (S3-compatible; MinIO defaults shown)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="htel-crm-documents"
STORAGE_ACCESS_KEY_ID="htelcrm"
STORAGE_SECRET_ACCESS_KEY="htelcrm123"
STORAGE_FORCE_PATH_STYLE="true"

# App
NODE_ENV="development"
LOG_LEVEL="info"

# ConnectUC call CDR + transcription ingestion. Not a client we call out
# to — an Activepieces flow holds the ConnectUC OAuth2 connection and
# POSTs "New CDR" / "New Call Transcription" webhook events in to
# /api/v1/integrations/connectuc/{cdr,transcription}. This secret is what
# those requests must present as `Authorization: Bearer <secret>`. Leave
# unset to reject all webhook calls (there's no mock mode for a push-based
# webhook — use curl with a matching header to exercise it locally).
CONNECTUC_WEBHOOK_SECRET=""

# Microsoft Graph (Outlook) email sync — an Entra ID app registration with
# Mail.Read (application or delegated, per mailbox consent model) is
# required. Leave unset to use the mock email provider.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""

# Vision Helpdesk ticket integration. Auth is either an access token
# (preferred) or a username+password (password is MD5-hashed before
# sending, per Vision Helpdesk's own API example). Leave unset to use the
# mock ticket client for local development/testing.
VISION_API_BASE_URL=""
VISION_API_TOKEN=""
VISION_API_USERNAME=""
VISION_API_PASSWORD=""
